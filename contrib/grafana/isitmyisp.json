    {
      "type": "timeseries",
      "title": "Loss by segment",
      "description": "Worst loss in each segment. Loss that starts at the router is yours; at the ISP hop, theirs.",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (role) (isitmyisp_loss_ratio{instance=~\"$instance\",role=~\"home|isp|anchor|voip|tcp|dns\"})",
          "legendFormat": "{{role}}",
          "refId": "R"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "home"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Router"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "isp"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ISP first hop"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "anchor"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Internet (anchors)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "voip"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "VoIP target"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tcp"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "TCP (anchors)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dns"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "DNS"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
