{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "isitmyisp",
  "uid": "isitmyisp",
  "tags": [
    "isitmyisp",
    "network"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Where the problem is (your network, the ISP or beyond), from isitmyisp's /metrics.",
  "links": [
    {
      "title": "isitmyisp",
      "type": "link",
      "url": "https://github.com/21Enzo17/isitmyisp",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Monitor",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(isitmyisp_build_info, instance)",
          "refId": "q"
        },
        "definition": "label_values(isitmyisp_build_info, instance)",
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {},
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Verdict",
      "description": "Where the problem is, from the last measurement window.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (code) (isitmyisp_verdict{instance=~\"$instance\"}) == 1",
          "legendFormat": "{{code}}",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Everything OK"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "local"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Your network (Wi-Fi / router)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "access"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ISP access link"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "isp"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ISP network"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "remote"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Beyond the ISP"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dns"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "DNS"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "no_data"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "No data"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "speedtest"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Speed test running"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "type": "stat",
      "title": "Internet availability",
      "description": "Share of the selected range with no internet incident open.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - sum(increase(isitmyisp_incident_seconds_total{instance=~\"$instance\",scope=\"internet\"}[$__range])) / $__range_s",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Call quality (MOS)",
      "description": "Estimated quality of a voice/video call right now (E-model, 1 to 4.5). Below 3.6 people notice.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "isitmyisp_call_quality_mos{instance=~\"$instance\"}",
          "legendFormat": "",
          "refId": "G",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "min": 1,
          "max": 4.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3.1
              },
              {
                "color": "yellow",
                "value": 3.6
              },
              {
                "color": "green",
                "value": 4.03
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Open incidents",
      "description": "Incidents open now (internet, services, devices, tunnels, backup link).",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(isitmyisp_incident_active{instance=~\"$instance\"} == 1) or vector(0)",
          "legendFormat": "",
          "refId": "I",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 14,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Check-up",
